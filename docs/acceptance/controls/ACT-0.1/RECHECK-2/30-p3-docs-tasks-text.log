== action.yml input config @ba73ba0 (python yaml):
'' required= False
Path to the epoch config (mode: target, record). Leave empty to use .gatekeeper/evidence.json if it exists (no file means epoch 1). If set, the file must exist (an error, never epoch 1), even when the path is .gatekeeper/evidence.json.
== action.yml target step run @ba73ba0:
{'GATEKEEPER_BIN': '${{ inputs.gatekeeper }}', 'REPO': '${{ github.repository }}', 'CONFIG': '${{ inputs.config }}'}
# --config only when the input is set: an explicit config must exist,
# an omitted one falls back to .gatekeeper/evidence.json / epoch 1.
config_args=()
if [ -n "$CONFIG" ]; then
  config_args=(--config "$CONFIG")
fi
"$GATEKEEPER_BIN" evidence-target --repo "$REPO" ${config_args[@]+"${config_args[@]}"} >> "$GITHUB_OUTPUT"

== LoadConfig @ba73ba0:
func LoadConfig(path string) (Config, error) {
	implicit := path == ""
	if implicit {
		path = DefaultConfigPath
	}
	// #nosec G304 -- path is DefaultConfigPath or the operator's own --config flag.
	data, err := os.ReadFile(path)
	if implicit && errors.Is(err, os.ErrNotExist) {
		return Config{Epoch: 1}, nil
	}
	if err != nil {
		return Config{}, fmt.Errorf("evidence: read config %s: %w", path, err)
	}
	dec := json.NewDecoder(bytes.NewReader(data))
	dec.DisallowUnknownFields()
	var cfg Config
	if err := dec.Decode(&cfg); err != nil {
		return Config{}, fmt.Errorf("evidence: parse config %s: %w", path, err)
	}
	// Decode stops after the first value; anything but end of input after
	// it (a second object, stray text) must not be silently ignored.
	if err := dec.Decode(&struct{}{}); !errors.Is(err, io.EOF) {
		return Config{}, fmt.Errorf("evidence: parse config %s: unexpected data after the JSON object", path)
	}
	if cfg.Epoch < 1 {
		return Config{}, fmt.Errorf("evidence: config %s: epoch must be >= 1, got %d", path, cfg.Epoch)
	}
	return cfg, nil
}
