# Скопируйте в .env и заполните. Файл .env в git не попадает (.gitignore).
# Сгенерировать случайные значения: openssl rand -hex 32

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@postgres:5432/gatekeeper?sslmode=disable

SPICEDB_ENDPOINT=spicedb:50051
SPICEDB_TOKEN=change-me

NATS_URL=nats://nats:4222

WEBHOOK_SECRET=change-me
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/app/key.pem

STRIPE_WEBHOOK_SECRET=
