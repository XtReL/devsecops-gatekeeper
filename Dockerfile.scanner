# Слой сборки Go-кода
FROM golang:alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /scanner ./cmd/scanner/main.go

# Слой исполнения
FROM alpine:latest
# Устанавливаем только git, он есть в базовых репозиториях Alpine
RUN apk add --no-cache git

# Gitleaks скачивается с официального релиза и проверяется по SHA-256
# (значение из gitleaks_8.30.1_checksums.txt). Бинарник в репозитории не хранится.
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
RUN wget -qO /tmp/gitleaks.tgz "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
 && echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tgz" | sha256sum -c - \
 && tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks \
 && rm /tmp/gitleaks.tgz \
 && gitleaks version

WORKDIR /app
COPY --from=builder /scanner .
CMD ["./scanner"]